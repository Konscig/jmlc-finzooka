# Finzooka ML Forecast Service — local env template.
# Copy to .env.local (gitignored) and fill in concrete values.

# ---- Infrastructure --------------------------------------------------------
ML_DATABASE_URL=postgresql://finzooka:finzooka@postgres:5432/finzooka
ML_REDIS_URL=redis://redis:6379/0

# ---- Paths -----------------------------------------------------------------
ML_ARTIFACT_DIR=/data/models
ML_ARCHIVE_DIR=/data/archive
ML_FORBIDDEN_PHRASES_PATH=/app/config/forbidden_phrases.yaml
ML_MOEX_HOLIDAYS_PATH=/app/config/moex_holidays_2026.yaml

# ---- Ports -----------------------------------------------------------------
ML_GRPC_PORT=50051
ML_METRICS_PORT=9100

# ---- Runtime logging -------------------------------------------------------
ML_LOG_LEVEL=INFO

# ---- Freshness thresholds (spec FR-002b) -----------------------------------
# OHLCV bar age must be <= OHLCV_MAX_AGE_MULTIPLIER * timeframe.seconds
ML_OHLCV_MAX_AGE_MULTIPLIER=1
# Sentiment aggregate age (seconds)
ML_SENTIMENT_MAX_AGE_SECONDS=3600

# ---- Training --------------------------------------------------------------
ML_TRAIN_MAX_DURATION_SECONDS=600
ML_OPTUNA_TRIALS=50
ML_OPTUNA_TIMEOUT_SECONDS=300
ML_WALKFORWARD_FOLDS=5

# ---- Model staleness (advisory flag model_stale, spec Edge Case) ----------
ML_MODEL_STALE_DAYS=14

# ---- gRPC server -----------------------------------------------------------
ML_GRPC_MAX_WORKERS=8
